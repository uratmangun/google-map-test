# Google Maps Platform. Create via: fish scripts/google-maps-api-key.fish
# See docs/google-maps-api-key.md
# Server key for Places + Static Maps + Maps Embed (MCP tools at /mcp)
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Maps quota dashboard (server-side Monitoring API)
# Must match the GCP project that owns GOOGLE_MAPS_API_KEY (API usage is billed there).
GCP_PROJECT_ID=coba-409011
# MAPS_FREE_TIER_ESSENTIALS_LIMIT=10000

# Better Auth — Google sign-in for /maps-usage
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID (Web)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Legacy names still supported: AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET

# Default Maps assistant LLM (server-side only; API key never sent to the browser)
# http://localhost is allowed for server env only; custom providers in API settings must use public HTTPS
AI_PROVIDER_BASE_URL=http://localhost:3000
AI_PROVIDER_API_KEY=
# Optional when the client does not send a model id:
# AI_PROVIDER_DEFAULT_MODEL=gpt-5.4
